{
  "manifest_version": 3,
  "name": "TabAssist",
  "version": "1.0.0",
  "description": "Hands-free guitar tab navigation on Songsterr via head gesture recognition.",
  "permissions": [
    "storage",
    "activeTab",
    "sidePanel"
  ],
  "host_permissions": [
    "https://www.songsterr.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://www.songsterr.com/*"],
      "js": ["content.js"]
    }
  ],
  "action": {
    "default_title": "Open TabAssist Side Panel"
  },
  "side_panel": {
    "default_path": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "lib/*"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}