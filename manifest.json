{
  "manifest_version": 3,
  "name": "TabAssist",
  "version": "1.0.0",
  "description": "Hands-free guitar tab navigation on Songsterr via head gesture recognition.",
  "permissions": [
    "storage",
    "activeTab",
    "sidePanel"
  ],
  "host_permissions": [
    "https://www.songsterr.com/*"
  ],

  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
  },

  "side_panel": {
    "default_path": "popup.html"
  },
  "action": {
    "default_title": "Open TabAssist Panel"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.songsterr.com/*"],
      "js": ["content.js"]
    }
  ]
}